# APP
APP_ENV=production

# DATABASE POSTGRESQL
DATABASE_URL=postgresql+psycopg2://username:password@host:5432/nama_database

# PERSISTENT STORAGE
STORAGE_DIR=/path/to/persistent/storage
LOG_DIR=/path/to/persistent/logs

# ADMIN
DEFAULT_ADMIN_USERNAME=admin_skripsi
DEFAULT_ADMIN_PASSWORD=password_production_yang_kuat
DEFAULT_ADMIN_FULL_NAME=Administrator

# AUTH
AUTH_SECRET_KEY=secret_key_production_panjang_dan_acak
AUTH_TOKEN_EXPIRE_HOURS=12
AUTH_COOKIE_NAME=pengangguran_admin_token

# UPLOAD
MAX_UPLOAD_SIZE_MB=50

# MODEL LSTM
WINDOW_SIZE=5
TRAIN_RATIO=0.8
LSTM_UNITS=32
DROPOUT_RATE=0.2
EPOCHS=300
BATCH_SIZE=4
VALIDATION_SPLIT=0.2
EARLY_STOPPING_PATIENCE=30
CORRELATION_THRESHOLD=0.3

# FUTURE PREDICTION
FUTURE_YEARS_DEFAULT=5
FUTURE_YEARS_MIN=1
FUTURE_YEARS_MAX=20

# TENSORFLOW
TF_ENABLE_ONEDNN_OPTS=0
TF_CPP_MIN_LOG_LEVEL=2
